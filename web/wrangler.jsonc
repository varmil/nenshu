{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nenshu",
  // 公開URLは `openreport.net` の1本だけにする（ADR-0006・U8）。
  // **`false` を明示しないと wrangler が既定で `workers.dev` を有効にし直す**。
  // カスタムドメインを付けたあとも `nenshu.<subdomain>.workers.dev` が本番と
  // 同じHTMLを200で返し続けており、Googleから見て同じサイトが2つのホストにある
  // 状態になる（2026-08-21 に実際にそうなっていた）。
  "workers_dev": false,
  // **`preview_urls` は `workers_dev` と対で書く。** 既定値は
  // `preview_urls = workers_dev` なので、上の1行だけだとプレビューURLまで無効になる
  // （wrangler 4.44.0 以降。うちは 4.123.0）。しかもこの既定は**デプロイのたびに
  // 適用される**ので、ダッシュボードでプレビューを有効にしても次のデプロイで落ちる。
  //
  // 消したいのは公開ホストとしての `nenshu.<subdomain>.workers.dev` だけで、
  // `<ブランチ名>-nenshu.<subdomain>.workers.dev` は本番に入れる前に実機で見るための
  // 経路である。全ページが `openreport.net` を指す canonical を出す（`lib/seo/site.ts`）
  // ので、プレビューが拾われても評価は正規URLへ寄る。
  //
  // **この設定はブランチのビルドでは反映されない。main に入って本番デプロイが走って
  // 初めて効く**（2026-08-21・Issue #119）。ブランチで3回デプロイしてもプレビューURLは
  // 出ず、マージ直後のビルドで出た。ここを触るときはブランチでの結果で判断しないこと。
  "preview_urls": true,
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": ".open-next/worker.js",
  // **事前生成した結果をアセットへ写す工程**（R1・ADR-0012・Issue #180）。
  //
  // `staticAssetsIncrementalCache` は `.open-next/assets/cdn-cgi/_next_cache/` から
  // ページを引く。そこへ写すのは `opennextjs-cloudflare deploy` の仕事だが、
  // **このプロジェクトのデプロイコマンドは `npx wrangler deploy`**（Cloudflare
  // ダッシュボード。`docs/ranking/project-foundation/design.md`）なので、その工程が
  // 走らない。**写さないままでもビルドは通り、デプロイは "successful" になり、
  // 全1,867ページが 404 を返す**——実際にプレビューでそうなった（#181）。
  //
  // `wrangler.jsonc` の `build.command` は `wrangler deploy`・`wrangler dev` の
  // どちらでも走るので、ダッシュボードを触らずに両方を直せる。**静かに壊れる経路
  // なので、写した結果を数える検証まで含めてビルドを落とす形にしてある。**
  "build": {
    "command": "npx opennextjs-cloudflare populateCache local && node scripts/write-404-asset.mjs && node scripts/assert-prerendered-assets.mjs",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // **存在しないパスで Worker を起動しない**（Issue #200 の一部・親 #118）。
    // ボットのスキャン（`/wp-admin/install.php`・`/.env` 等）が Worker を起こして
    // CPU を使っていた（本番の実測で 122ms）。アセットに一致しないリクエストは
    // `404.html` で返し、Worker を呼ばない。
    //
    // **`not_found_handling` だけを書くとサイトが全部 404 になる。** 既定で有効な
    // `assets_navigation_prefers_asset_serving`（2025-04-01 以降）により、
    // ナビゲーションリクエストは**アセットに一致しなくても Worker より先に
    // `404.html` が返る**——`/` も `/about` も `/company/[id]` もアセットには
    // 無いので、全滅する（ローカルで実際に全部 404 になった）。
    "not_found_handling": "404-page",
    // **だから Worker が処理するパスを明示する。** ここに載っていないパスは
    // Worker を経由せず 404 になる。
    //
    // **ページを足したらここにも足すこと。** 忘れると本番でそのページだけが
    // 404 になり、**dev サーバーには `run_worker_first` が効かないので E2E では
    // 気づけない**（#183 と同じ穴）。`e2e/asset-routing.spec.ts` を Worker に
    // 向けて回すと落ちる。
    "run_worker_first": ["/", "/about", "/company/*", "/sitemap.xml", "/robots.txt"],
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "nenshu" }],
  "cache": {
    "enabled": true,
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
