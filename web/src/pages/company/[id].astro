---
/**
 * 企業詳細（C1〜C4・R1）。**全社をビルド時に生成して静的アセットで返す**
 * ——Worker を起こさない（F1・AC-1）。ADR-0012 の決定1（全社を事前生成）と
 * 決定3（表示基準を URL に出さない）はそのまま。
 */
import Base from "@/src/layouts/Base.astro";
import { CompanyDetailIsland } from "@/features/company/components/CompanyDetailIsland";
import {
  companyAnalysisFor,
  companyFilingDocId,
  companyIds,
  companyPageData,
  companyPayPolicyFor,
  companySummaryDocId,
  isLapsedCompany,
  lapsedPageData,
} from "@/features/company/lib/pageData";
import { LapsedCompanyDetail } from "@/features/company/components/LapsedCompanyDetail";
import { lapsedPageMeta } from "@/features/company/lib/lapsed";
import { AnalysisSection, DigestSection } from "@/features/company/components/AnalysisSections";
import { ActualsQaSection } from "@/features/company/components/ActualsQaSection";
import { PayPolicySection } from "@/features/company/components/PayPolicySection";
import { buildActualsQa } from "@/features/company/lib/actualsQa";
import { SourcesSection } from "@/features/company/components/SourcesSection";
import { buildSourceRows } from "@/features/company/lib/sources";
import { companyPageMeta } from "@/lib/seo/company";
import { breadcrumbJsonLd } from "@/lib/seo/jsonLd";
import { companyBreadcrumb } from "@/features/company/lib/breadcrumb";

export function getStaticPaths() {
  return companyIds().map((id) => ({ params: { id } }));
}

const id = Astro.params.id!;
// **母集団から外れた会社（最後の有報から24か月）は別の画面**（refresh の D9・#879）。順位・偏差値・
// 近傍が無く、操作も無いので島を持たない。どの節を残したかは `LapsedCompanyDetail` の注記。
const lapsed = isLapsedCompany(id) ? lapsedPageData(id) : null;
const data = lapsed === null ? companyPageData(id) : null;
const company = lapsed?.company ?? data!.view;
const meta = lapsed !== null ? lapsedPageMeta(lapsed.company) : companyPageMeta(data!.view, data!.fiscalPeriod);
// 推移と説明文の有無（出典の節が挙げる行を決める）。どちらの画面のデータも同じ名前で持つ
const page = lapsed ?? data!;
// 有報の要約と AI 分析（C10・#242）。**`data` に入れない**——島の props を通さず、
// 下の名前付きスロットで静的な HTML として差し込む（`features/company/lib/analysis.ts`）。
// 外れた会社には出さない（書いた時点の見立てを「今後」として読ませない。要約は分析と対）
const analysis = lapsed === null ? companyAnalysisFor(id) : null;
// 実測値の4項目を取った有報（C13・#814）。Q&A の帯と出典の節の2か所が同じ書類を指す。
// **`data` に入れない**——どちらも島の外で描くので、島の props に載せる理由が無い（C16・#838）。
const filingDocId = companyFilingDocId(id);
// 給与の決定方針（C19・#852）。有報の原文そのもので、表示基準でも年齢でも変わらないので、
// C10・C16 と同じく名前付きスロットで静的な HTML として差し込む。無い会社は `null`（節ごと出さない）。
const payPolicy = companyPayPolicyFor(id, company.name);
// 「{社名}の年収に関するQ&A」（C16・#838）。表示基準でも年齢でも変わらないので、C10・C12 と
// 同じく名前付きスロットで静的な HTML として差し込む。
const qa = buildActualsQa(company, lapsed?.company.fiscalPeriod ?? data!.fiscalPeriod);
// 「このページの出典」（C12・#805）。**ページに出ている節だけを挙げる**ので、有無はここで渡す。
// 有報を挙げる行は、その行の中身を作った書類を指す（refresh の D3）。
const sourceRows = buildSourceRows({
  history: page.history !== null,
  tenureHistory: page.tenureHistory !== null,
  filingDocId,
  summaryDocId: page.summary !== null ? companySummaryDocId(id) : null,
  analysisDocId: analysis?.docId ?? null,
  payPolicyDocId: payPolicy?.docId ?? null,
  // 母集団から外れた会社のページには順位・分布・レーダー・年齢別の推定年収が無い（D9）
  ranked: lapsed === null,
  profitHistory: page.profitHistory !== null,
});
---

<Base meta={meta}>
  {/*
    画面のパンくずと同じ階層を機械可読にする（S2・AC-14）。**同じ配列から出す**
    ので、段を足したり行き先を変えたりしても片方だけ古くならない。
  */}
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbJsonLd(companyBreadcrumb(company)))}
  />
  {
    lapsed !== null ? (
      <LapsedCompanyDetail data={lapsed}>
        {payPolicy && <PayPolicySection slot="payPolicy" view={payPolicy} />}
        <ActualsQaSection slot="qa" qa={qa} docId={filingDocId} />
        <SourcesSection slot="sources" rows={sourceRows} />
      </LapsedCompanyDetail>
    ) : (
      <CompanyDetailIsland data={data!} client:load>
        {analysis && <AnalysisSection slot="analysis" name={company.name} view={analysis} />}
        {analysis && <DigestSection slot="digest" name={company.name} view={analysis} />}
        {payPolicy && <PayPolicySection slot="payPolicy" view={payPolicy} />}
        <ActualsQaSection slot="qa" qa={qa} docId={filingDocId} />
        <SourcesSection slot="sources" rows={sourceRows} />
      </CompanyDetailIsland>
    )
  }
</Base>
